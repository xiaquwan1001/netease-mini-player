<?xml version="1.0" encoding="utf-8"?>
<!-- 只放行网易云系域名 + 局域网验证服务 的明文流量(播放地址是 http://*.music.126.net) -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">music.126.net</domain>
        <domain includeSubdomains="true">music.163.com</domain>
        <domain includeSubdomains="true">126.net</domain>
        <domain>10.42.0.1</domain>
    </domain-config>
</network-security-config>

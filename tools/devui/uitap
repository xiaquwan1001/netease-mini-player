#!/usr/bin/env bash
# 按语义文案点击: DEV=emulator-5554 tools/devui/uitap "分享这首歌"
set -uo pipefail
here=$(dirname "$0")
kw=${1:?usage: uitap <文案关键词>}
line=$("$here/uix" "$kw" | head -1)
if [ -z "$line" ]; then echo "NOT_FOUND: $kw" >&2; exit 3; fi
x=$(printf '%s' "$line" | sed -E 's/.*tap +([0-9]+) +([0-9]+).*/\1/')
y=$(printf '%s' "$line" | sed -E 's/.*tap +([0-9]+) +([0-9]+).*/\2/')
echo "tap $kw -> $x,$y"
export PATH="${ANDROID_HOME:-$HOME/android-dev/sdk}/platform-tools:$PATH"
adb -s "${DEV:-emulator-5554}" shell input tap "$x" "$y"

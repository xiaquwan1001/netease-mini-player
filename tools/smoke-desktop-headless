#!/usr/bin/env bash
# 桌面端**无图形会话**的自动化冒烟(平台审计 P-11 ②: 桌面自动化此前为零)。
#
# 用法:
#   tools/smoke-desktop-headless                 # 用现成 release bundle
#   BUNDLE=<路径> tools/smoke-desktop-headless
#   BUILD=1 tools/smoke-desktop-headless         # 先 flutter build linux --release(慢, 默认不做)
#
# 判据(全部自动断言, 不需要人看屏幕):
#   ① 进程在 xvfb + 独立 dbus session 下能起来并稳定存活(默认 8s);
#   ② 用 $NCM_DATA_DIR 指定的**临时**数据目录会被创建(证明 Rust 内核真的起来并解析了路径,
#      且**不碰**用户真实的 ~/.local/share);
#   ③ 同一 dbus session 内再启一个实例 2s 内退出(严格单实例, P-18 后半);
#   ④ 临时数据目录里写出 identity.json(持久层真的初始化了);
#   ⑤ SIGTERM 能干净收尾(不留下僵尸/不挂死)。
#
#   ⑦ 关闭按钮行为(lane/tray-close), 三个子用例(都用自带的 WM_DELETE_WINDOW 小工具
#      发**真实**关闭请求, 因为 xdotool windowclose 是 XDestroyWindow, 绕过 delete-event):
#      a. 默认配置 ⇒ 收到关闭请求即退出(与旧版一致);
#      b. closeBehavior=tray 且**没有**托盘宿主 ⇒ 进程仍在 + 降级为"最小化到任务栏"(日志留痕);
#      c. closeBehavior=tray 且**有**宿主(脚本自带最小假 StatusNotifierWatcher)⇒ 主窗口
#         unmap(隐藏), 进程仍在 —— 这就是"关到托盘不停播放"的自动化证据。
#
#   ⑥ 窗口存在 + 标题非空 + WM_CLASS = application-id + 几何 >= 200x200。
#      注意: 必须 unset WAYLAND_DISPLAY + GDK_BACKEND=x11(脚本内已做), 否则 GTK 会连真实
#      compositor, 窗口跑到用户屏幕上而 xvfb 里看不到任何子窗口。
#
#   ⑧ 交互级断言(P-11 剩余, 2026-11-18): 真的往应用里**注入 X11 输入**, 再断言
#      「进程存活 + 窗口依旧 viewable + 标题不变 + 几何不变」。四段:
#      a. 输入焦点: `xdotool windowfocus` 把 X 输入焦点移到主窗口, 再 `getwindowfocus`
#         回读确认 —— 焦点拿不到就没法注入按键(下面 b 会 SKIP 而不是假装通过);
#      b. 按键: 焦点确实在应用上时, 用 XTEST 发 space / Tab / space / Escape(真实事件,
#         不是 xdotool `key --window` 的 XSendEvent —— GTK 会丢弃后者);
#      c. 鼠标: XTEST 在播放条那一行(窗口底部 导航栏之上)横扫三个点各点一次 + 进度条
#         一个点, 覆盖「点播放条/播放键」这类点击;
#      d. 几何: 缩到 640x480 再缩到 320x240(矮/窄布局重新排版)再还原, 每次都断言进程
#         存活且标题不变, 还原后几何必须回到初始值。
#      另加: 应用日志里不得出现 `segmentation fault` / `core dumped` / `GLib-ERROR`
#      / `Gtk-ERROR` / `FATAL`(崩溃被 X11 层「幸存」掩盖的情况)。
#      **断言边界(为什么不更强)**: 无 WM 的 xvfb 里**观察不到 Dart 层的状态变化** ——
#      Flutter 把语义树留空(实测 AT-SPI 只有空的 panel/filler, 见 2026-11-18 探针),
#      窗口标题是编译期常量(不随播放/页面变化), 未登录 + 离线也拿不到能触发
#      `touchInteraction` 的条目 ⇒ 只能断言「输入打进窗口后没崩、窗口属性没被破坏」;
#      要断言「空格真的切了播放」得有 app 侧埋点(debug 日志/`--e2e` 通道), 目前没有。
#
# 退出码: 0 全通过 / 1 有断言失败 / 3 缺工具(不是失败, 门禁按 SKIP 处理)。
set -uo pipefail

ROOT=$(cd "$(dirname "$0")/.." && pwd)
BUNDLE=${BUNDLE:-$ROOT/ui/build/linux/x64/release/bundle}
ALIVE_SECONDS=${ALIVE_SECONDS:-8}
SECOND_INSTANCE_WAIT_MS=${SECOND_INSTANCE_WAIT_MS:-2000}

ok()   { printf '[ OK ] %s\n' "$1"; }
bad()  { printf '[FAIL] %s\n' "$1"; FAILED=1; }
skip() { printf '[SKIP] %s\n' "$1"; }
info() { printf '[INFO] %s\n' "$1"; }
FAILED=0

for tool in xvfb-run dbus-run-session timeout; do
  command -v "$tool" >/dev/null 2>&1 || { skip "缺 $tool, 无法无头驱动桌面版"; exit 3; }
done

if [ "${BUILD:-0}" = "1" ]; then
  ( cd "$ROOT/ui" && flutter build linux --release ) || { bad "flutter build linux --release 失败"; exit 1; }
fi

BIN="$BUNDLE/minincm"
[ -x "$BIN" ] || { skip "没有可执行的 bundle($BIN): 先 BUILD=1 或 flutter build linux --release"; exit 3; }
# 0 字节二进制是硬件不稳期的真实故障(见 notes-build.md), 先挡掉, 免得把"打不开"当产品问题
[ -s "$BIN" ] || { bad "bundle 里的 minincm 是 0 字节(打包产物损坏)"; exit 1; }

# WM_CLASS 必须与 application-id 一致(任务栏归组/AppStream 关联, P-18 后半)
APP_ID=${APP_ID:-io.github.xiaquwan1001.MiniNCM}

TMP=$(mktemp -d)
cleanup() { rm -rf "$TMP"; }
trap cleanup EXIT
# 自报成本(秒): 门禁耗时数字不要靠拍脑袋, 由脚本自己报(实现在下面).
T_START=$(date +%s)

info "bundle: $BIN"
info "临时数据目录: $TMP/data"

# 内层脚本在同一个 dbus session 里跑: 单实例判定依赖同一总线。
cat > "$TMP/inner.sh" <<INNER
#!/usr/bin/env bash
set -uo pipefail
BIN="$BIN"
DATA="$TMP/data"
LOG1="$TMP/first.log"
LOG2="$TMP/second.log"
export NCM_DATA_DIR="\$DATA"
# 关键: 调用方 shell 里可能带着真实桌面的 WAYLAND_DISPLAY(本机 = wayland-0)。
# 不摘掉的话 GTK 会绕过 xvfb 去连真实 compositor —— 窗口出现在用户屏幕上,
# 而 xwininfo 在 xvfb 里永远看到 0 个子窗口(2026-11-17 实测, 就是这样被坑的)。
unset WAYLAND_DISPLAY
export GDK_BACKEND=x11

"\$BIN" >"\$LOG1" 2>&1 &
P1=\$!
sleep $ALIVE_SECONDS
if kill -0 "\$P1" 2>/dev/null; then
  echo "ALIVE=1"
else
  echo "ALIVE=0"
fi
if [ -d "\$DATA" ]; then echo "DATADIR=1"; else echo "DATADIR=0"; fi
# 内核真的初始化了持久层(身份文件): 只看目录存在不够, 空目录也可能是刚 mkdir。
if [ -f "\$DATA/identity.json" ]; then echo "IDENTITY=1"; else echo "IDENTITY=0"; fi

# 窗口级断言: 真起了窗口 + 标题非空 + WM_CLASS(= application-id) + 尺寸像正常窗口。
#
# 用 xwininfo -root -tree 解析而不是 xdotool search: 后者会把 10x10 的辅助窗口排在前面
# (实测 getwindowgeometry 拿到 WIDTH=10 HEIGHT=10), 而树里带 WM_CLASS 的那一行同时给出
# 标题和 "1280x720+0+0" 几何 —— 一处解析就够, 也不会误判辅助窗口。
if command -v xwininfo >/dev/null 2>&1; then
  TREE=\$(xwininfo -root -tree 2>/dev/null)
  LINE=\$(printf '%s\n' "\$TREE" | grep -F "(\"$APP_ID\"" | head -1)
  if [ -n "\$LINE" ]; then
    echo "WINDOW=1"
    echo "TITLE=\$(printf '%s\n' "\$LINE" | sed -n 's/^ *0x[0-9a-f]* "\([^"]*\)".*/\1/p')"
    echo "GEOMETRY=\$(printf '%s\n' "\$LINE" | grep -oE '[0-9]+x[0-9]+\+-?[0-9]+\+-?[0-9]+' | head -1)"
  else
    # 报错要能自证: 有窗口但 WM_CLASS 不对(归组坏) vs 压根没窗口(渲染/启动坏)
    ALT=\$(printf '%s\n' "\$TREE" | grep -E '"(轻音|MiniNCM)' | head -1)
    if [ -n "\$ALT" ]; then
      echo "WINDOW=2"
      echo "ALT_LINE=\$ALT"
    else
      echo "WINDOW=0"
      echo "WINDOW_TREE=\$(printf '%s\n' "\$TREE" | head -6 | tr '\n' ' ')"
    fi
  fi
else
  echo "WINDOW=skip"
fi

# 第二个实例: 严格单实例 ⇒ 应该很快自己退出
T0=\$(date +%s%3N)
"\$BIN" >"\$LOG2" 2>&1 &
P2=\$!
WAITED=0
while [ \$WAITED -lt $SECOND_INSTANCE_WAIT_MS ]; do
  kill -0 "\$P2" 2>/dev/null || break
  sleep 0.05
  WAITED=\$(( \$(date +%s%3N) - T0 ))
done
if kill -0 "\$P2" 2>/dev/null; then
  echo "SECOND_EXITED=0"
  kill -9 "\$P2" 2>/dev/null || true
else
  echo "SECOND_EXITED=1"
fi
wait "\$P2" 2>/dev/null || true

# SIGTERM 收尾
kill -TERM "\$P1" 2>/dev/null || true
T1=\$(date +%s%3N)
while kill -0 "\$P1" 2>/dev/null; do
  [ \$(( \$(date +%s%3N) - T1 )) -gt 5000 ] && { kill -9 "\$P1" 2>/dev/null || true; break; }
  sleep 0.05
done
wait "\$P1" 2>/dev/null || true
echo "FIRST_LOG=\$LOG1"
INNER
chmod +x "$TMP/inner.sh"

OUT=$(timeout -k 10 60 xvfb-run -a dbus-run-session -- "$TMP/inner.sh" 2>&1)
RC=$?
printf '%s\n' "$OUT" | sed 's/^/  | /'
if [ $RC -ne 0 ]; then
  bad "无头运行整体退出码 $RC(xvfb/dbus 或进程异常)"
fi

grep -q '^ALIVE=1$' <<<"$OUT" && ok "进程存活 ${ALIVE_SECONDS}s(启动成功)" || bad "进程在 ${ALIVE_SECONDS}s 内退出"
grep -q '^DATADIR=1$' <<<"$OUT" && ok "临时数据目录已创建(内核起来且不碰真实 HOME)" || bad "数据目录没被创建"
grep -q '^IDENTITY=1$' <<<"$OUT" && ok "身份文件 identity.json 已写入(持久层初始化)" || bad "数据目录里没有 identity.json"
case "$(grep '^WINDOW=' <<<"$OUT")" in
  WINDOW=1)
    # 匹配到 `("$APP_ID"` 的行 ⇒ WM_CLASS 已经是 application-id(任务栏归组/AppStream 关联的前提)
    ok "窗口已创建且 WM_CLASS = application-id"
    TITLE=$(sed -n 's/^TITLE=//p' <<<"$OUT" | head -1)
    if [ -n "$TITLE" ]; then ok "窗口标题: $TITLE"; else bad "窗口标题为空"; fi
    GEO=$(sed -n 's/^GEOMETRY=//p' <<<"$OUT" | head -1)
    if [ -z "$GEO" ]; then
      bad "读不到窗口几何"
    else
      W=$(printf '%s' "$GEO" | cut -dx -f1)
      H=$(printf '%s' "$GEO" | sed 's/^[0-9]*x//; s/+.*//')
      if [ "${W:-0}" -ge 200 ] && [ "${H:-0}" -ge 200 ]; then
        ok "窗口几何正常: $GEO"
      else
        bad "窗口几何异常(过小, 可能是辅助窗口): $GEO"
      fi
    fi
    ;;
  WINDOW=2)
    bad "有窗口但 WM_CLASS 不含 application-id(归组会坏): $(sed -n 's/^ALT_LINE=//p' <<<"$OUT" | head -1)"
    ;;
  WINDOW=0)
    bad "没有找到应用窗口(树里无匹配): $(sed -n 's/^WINDOW_TREE=//p' <<<"$OUT" | head -1)"
    ;;
  *) skip "窗口断言: 缺 xwininfo" ;;
esac
grep -q '^SECOND_EXITED=1$' <<<"$OUT" && ok "第二个实例自行退出(严格单实例)" || bad "第二个实例没有在 2s 内退出"

# ⑧ 交互级断言(P-11 剩余): 注入真实 X11 输入后, 进程/窗口属性必须不变。
#
# 单独开一个 xvfb + dbus session: 不和上面那轮(要测 SIGTERM 收尾)共享状态,
# 失败时也能按段归因。用 quoted heredoc 写内层脚本(无 shell 展开), 好读也少 escape。
if ! command -v xdotool >/dev/null 2>&1; then
  skip "交互级断言: 缺 xdotool(按键/点击/几何注入)"
else
  cat > "$TMP/interact.sh" <<'INTERACT'
#!/usr/bin/env bash
set -uo pipefail
BIN=$1; DATA=$2; LOG=$3; PNAME=$4
export NCM_DATA_DIR="$DATA"
# 同上: 不摘掉真实桌面的 WAYLAND_DISPLAY 会把窗口开到用户屏幕上
unset WAYLAND_DISPLAY
export GDK_BACKEND=x11
mkdir -p "$DATA"
"$BIN" >"$LOG" 2>&1 &
P=$!
trap 'kill -9 "$P" 2>/dev/null || true' EXIT

# 等窗口出现**并真的 map 上来**(最多 25s; 冷启动 + Rust 内核初始化会慢于固定的 sleep).
# 注意不能只看 search 有没有命中: 窗口对象先建出来、几帧后才 map, 那一刻
# Map State 还是 IsUnMapped, XSetInputFocus 到未 map 的窗口会 BadMatch ⇒ 焦点拿不到。
WID=""
MS=""
for _ in $(seq 1 50); do
  # 要的是**主窗口**, 不是 xdotool search 会排在前面那个 10x10 辅助窗口(实测):
  # 逐候选按几何筛 >= 200x200, 再要 Map State=IsViewable(未 map 的窗口 XSetInputFocus
  # 会 BadMatch ⇒ 焦点/按键断言全废)。
  while read -r cand; do
    [ -n "$cand" ] || continue
    cg=$(xwininfo -id "$cand" 2>/dev/null | awk '/^  Width:/{w=$2} /^  Height:/{h=$2} END{print w" "h}')
    cw=${cg% *}; ch=${cg#* }
    [ "${cw:-0}" -ge 200 ] 2>/dev/null || continue
    [ "${ch:-0}" -ge 200 ] 2>/dev/null || continue
    WID=$cand
    MS=$(xwininfo -id "$WID" 2>/dev/null | sed -n 's/^ *Map State: *//p')
    [ "$MS" = "IsViewable" ] && break
  done <<<"$(xdotool search --name "$PNAME" 2>/dev/null)"
  [ "$MS" = "IsViewable" ] && break
  sleep 0.5
done
if [ -z "$WID" ]; then
  echo "INTERACT_WINDOW=0"
  exit 0
fi
if [ "$MS" != "IsViewable" ]; then
  echo "INTERACT_WINDOW=2"   # 窗口有了但一直没 map 上来
  exit 0
fi
sleep 0.5
echo "INTERACT_WINDOW=1"

# 一次采齐「几何/标题/映射状态」: 全部走 X11 查询, 不依赖截图
props() {
  local g t m
  g=$(xwininfo -id "$WID" 2>/dev/null \
    | awk '/^  Width:/{w=$2} /^  Height:/{h=$2} END{print w"x"h}')
  t=$(xdotool getwindowname "$WID" 2>/dev/null)
  m=$(xwininfo -id "$WID" 2>/dev/null | sed -n 's/^ *Map State: *//p')
  echo "${1}_GEO=$g"
  echo "${1}_TITLE=$t"
  echo "${1}_MAP=$m"
}
alive() { if kill -0 "$P" 2>/dev/null; then echo "${1}=1"; else echo "${1}=0"; fi; }

BASE_LINES=$(props BASE)
printf '%s\n' "$BASE_LINES"
BASE_GEO=$(sed -n 's/^BASE_GEO=//p' <<<"$BASE_LINES" | head -1)

# --- a. 输入焦点: 无 WM 的 xvfb 里 windowactivate 不可用(要 EWMH 窗口管理器), 但
#        windowfocus = XSetInputFocus 不需要 WM; 回读 getwindowfocus 自证焦点真的到了应用上。
xdotool windowfocus --sync "$WID" 2>/dev/null
FOCUS=$(xdotool getwindowfocus 2>/dev/null)
if [ "$FOCUS" = "$WID" ]; then echo "FOCUS_TAKEN=1"; else echo "FOCUS_TAKEN=0"; fi
echo "FOCUS_GOT=$FOCUS"

# --- b. 按键(XTEST 真实事件; 焦点不在应用上就如实标 SENT=0, 不假装通过)
if [ "$FOCUS" = "$WID" ]; then
  KRC=0
  for k in space Tab space Escape; do
    xdotool key --clearmodifiers "$k" || KRC=1
    sleep 0.2
  done
  echo "KEYS_SENT=1"
  echo "KEYS_RC=$KRC"
else
  echo "KEYS_SENT=0"
  echo "KEYS_RC=1"
fi
sleep 1
alive ALIVE_AFTER_KEYS
props KEYS

# --- c. 鼠标: 在播放条那一行横扫(窗口宽 15% / 50% / 85%, 高度 = 底边上方 110px ⇒
#        落在「播放进度条 + 信息/控件行」里, 导航栏在它下面约 80px), 再加进度条一点。
W=${BASE_GEO%%x*}
H=${BASE_GEO##*x}
CROW=$(( H - 110 ))
CSLIDER=$(( H - 140 ))
CRC=0
for x in $(( W * 15 / 100 )) $(( W / 2 )) $(( W * 85 / 100 )); do
  xdotool mousemove --sync --window "$WID" "$x" "$CROW" || CRC=1
  xdotool click 1 || CRC=1
  sleep 0.4
done
xdotool mousemove --sync --window "$WID" $(( W / 2 )) "$CSLIDER" || CRC=1
xdotool click 1 || CRC=1
echo "CLICKS_DONE=4"
echo "CLICKS_RC=$CRC"
sleep 1
alive ALIVE_AFTER_CLICKS
props CLICKS

# --- d. 几何: 缩小(窄/矮布局重新排版) ⇒ 还原几何必须回到初始值
xdotool windowsize --sync "$WID" 640 480 || true
sleep 1.5
props SHRINK
alive ALIVE_AFTER_SHRINK
xdotool windowsize --sync "$WID" 320 240 || true
sleep 1.5
props TINY
alive ALIVE_AFTER_TINY
xdotool windowsize --sync "$WID" "$W" "$H" || true
sleep 1.5
props RESTORE
alive ALIVE_AFTER_RESTORE
echo "BASE_GEO_USED=$BASE_GEO"

# --- e. 顶层窗口没多出来(没有崩溃弹窗/重复主窗口)
echo "APP_WINDOWS=$(xdotool search --name "$PNAME" 2>/dev/null | wc -l)"

kill -TERM "$P" 2>/dev/null || true
sleep 1
kill -9 "$P" 2>/dev/null || true
INTERACT
  chmod +x "$TMP/interact.sh"
  WINDOW_TITLE=$(sed -n 's/^TITLE=//p' <<<"$OUT" | head -1)
  OUTI=$(timeout -k 10 120 xvfb-run -a dbus-run-session -- \
    "$TMP/interact.sh" "$BIN" "$TMP/interact/data" "$TMP/interact.log" \
    "${WINDOW_TITLE:-轻音 MiniNCM}" 2>&1)
  printf '%s\n' "$OUTI" | grep -E '^(INTERACT_WINDOW|BASE_|FOCUS_|KEYS_|ALIVE_AFTER_KEYS|CLICKS_|ALIVE_AFTER_CLICKS|SHRINK_|TINY_|RESTORE_|ALIVE_AFTER|APP_WINDOWS|BASE_GEO_USED)=' \
    | sed 's/^/  | /'
  if ! grep -q '^INTERACT_WINDOW=1$' <<<"$OUTI"; then
    bad "交互级断言: 25s 内没等到 map 上来的主窗口($(grep '^INTERACT_WINDOW=' <<<"$OUTI"))"
  else
    IBASE_GEO=$(sed -n 's/^BASE_GEO=//p' <<<"$OUTI" | head -1)
    IBASE_TITLE=$(sed -n 's/^BASE_TITLE=//p' <<<"$OUTI" | head -1)
    IBASE_MAP=$(sed -n 's/^BASE_MAP=//p' <<<"$OUTI" | head -1)
    # 初始状态本身是后面所有「没变」断言的基准
    if [ -n "$IBASE_GEO" ] && [ "$IBASE_MAP" = "IsViewable" ]; then
      ok "交互前基准: 几何 $IBASE_GEO / 标题 '$IBASE_TITLE' / viewable"
    else
      bad "交互前基准取不到(几何 '${IBASE_GEO:-}' 映射 '${IBASE_MAP:-}')"
    fi

    # a/b 焦点 + 按键
    if grep -q '^FOCUS_TAKEN=1$' <<<"$OUTI"; then
      ok "X 输入焦点已切到主窗口(windowfocus 回读一致)"
      if grep -q '^KEYS_RC=0$' <<<"$OUTI"; then
        ok "按键已注入(space/Tab/space/Escape, XTEST)"
      else
        bad "按键注入失败(xdotool key 返回非 0)"
      fi
      if grep -q '^ALIVE_AFTER_KEYS=1$' <<<"$OUTI"; then
        ok "按键后进程存活"
      else
        bad "按键后进程退出"
      fi
      IKG=$(sed -n 's/^KEYS_GEO=//p' <<<"$OUTI" | head -1)
      IKT=$(sed -n 's/^KEYS_TITLE=//p' <<<"$OUTI" | head -1)
      IKM=$(sed -n 's/^KEYS_MAP=//p' <<<"$OUTI" | head -1)
      if [ "$IKG" = "$IBASE_GEO" ] && [ "$IKT" = "$IBASE_TITLE" ] && [ "$IKM" = "$IBASE_MAP" ]; then
        ok "按键后窗口属性不变(几何/标题/映射状态)"
      else
        bad "按键后窗口属性变了(几何 '${IKG:-}' 标题 '${IKT:-}' 映射 '${IKM:-}')"
      fi
    else
      skip "按键断言: 拿不到 X 输入焦点(windowfocus 回读 $(sed -n 's/^FOCUS_GOT=//p' <<<"$OUTI" | head -1))"
    fi

    # c 点击
    if grep -q '^ALIVE_AFTER_CLICKS=1$' <<<"$OUTI"; then
      ok "播放条点击后进程存活($(sed -n 's/^CLICKS_DONE=//p' <<<"$OUTI" | head -1) 次 XTEST 点击)"
    else
      bad "播放条点击后进程退出"
    fi
    ICG=$(sed -n 's/^CLICKS_GEO=//p' <<<"$OUTI" | head -1)
    ICT=$(sed -n 's/^CLICKS_TITLE=//p' <<<"$OUTI" | head -1)
    ICM=$(sed -n 's/^CLICKS_MAP=//p' <<<"$OUTI" | head -1)
    if [ "$ICG" = "$IBASE_GEO" ] && [ "$ICT" = "$IBASE_TITLE" ] && [ "$ICM" = "$IBASE_MAP" ]; then
      ok "点击后窗口属性不变(几何/标题/映射状态)"
    else
      bad "点击后窗口属性变了(几何 '${ICG:-}' 标题 '${ICT:-}' 映射 '${ICM:-}')"
    fi

    # d 几何交互: 缩到 640x480 / 320x240 再还原
    ISG=$(sed -n 's/^SHRINK_GEO=//p' <<<"$OUTI" | head -1)
    ITG=$(sed -n 's/^TINY_GEO=//p' <<<"$OUTI" | head -1)
    IRG=$(sed -n 's/^RESTORE_GEO=//p' <<<"$OUTI" | head -1)
    if [ "$ISG" = "640x480" ] && grep -q '^ALIVE_AFTER_SHRINK=1$' <<<"$OUTI"; then
      ok "缩窗到 640x480 生效且进程存活(窄布局重新排版不崩)"
    else
      bad "缩窗到 640x480 异常(几何 '${ISG:-}')"
    fi
    if [ "$ITG" = "320x240" ] && grep -q '^ALIVE_AFTER_TINY=1$' <<<"$OUTI"; then
      ok "缩窗到 320x240 生效且进程存活(极小窗口重新排版不崩)"
    else
      bad "缩窗到 320x240 异常(几何 '${ITG:-}')"
    fi
    IRT=$(sed -n 's/^RESTORE_TITLE=//p' <<<"$OUTI" | head -1)
    IRM=$(sed -n 's/^RESTORE_MAP=//p' <<<"$OUTI" | head -1)
    if [ "$IRG" = "$IBASE_GEO" ] && grep -q '^ALIVE_AFTER_RESTORE=1$' <<<"$OUTI" \
        && [ "$IRT" = "$IBASE_TITLE" ] && [ "$IRM" = "IsViewable" ]; then
      ok "还原几何到 $IRG 且标题/viewable 不变"
    else
      bad "还原几何失败(几何 '${IRG:-}' 标题 '${IRT:-}' 映射 '${IRM:-}')"
    fi

    # e 仍然只有一个主窗口
    if [ "$(sed -n 's/^APP_WINDOWS=//p' <<<"$OUTI" | head -1)" = "1" ]; then
      ok "交互后仍只有一个主窗口(没冒出崩溃弹窗/重复窗口)"
    else
      bad "交互后主窗口数 != 1($(sed -n 's/^APP_WINDOWS=//p' <<<"$OUTI" | head -1))"
    fi

    # f 日志里不能有崩溃痕迹(SIGSEGV 后进程偶尔还「活着」到下一帧, 只看存活不够)
    FATAL=$(grep -aiE 'segmentation fault|core dumped|GLib-ERROR|Gtk-ERROR|^FATAL|panic' \
      "$TMP/interact.log" 2>/dev/null | head -3)
    if [ -z "$FATAL" ]; then
      ok "交互全程应用日志无崩溃痕迹(segfault/core/GLib-ERROR/panic)"
    else
      bad "交互过程中日志出现崩溃痕迹: $FATAL"
    fi
  fi
fi

# ⑦ 关闭按钮行为(lane/tray-close): 默认"直接退出" + 设置成托盘时"隐藏(无宿主则降级)"。
#
# 必须用真正的 WM_DELETE_WINDOW 客户端消息, 不能用 xdotool windowclose: 后者是直接
# XDestroyWindow(销毁窗口时 GTK 根本不发 delete-event), 拿它测关闭行为会得到
# 假结论 —— 实测"设了托盘模式进程照样退出", 其实是测试手法错了。
# 两个用例各开一个独立 dbus session: 严格单实例按总线判定, 同一总线里第二个进程只会
# 激活第一个, 换不了配置。
CLOSE_HELPER="$TMP/wmdelete"
if ! command -v xdotool >/dev/null 2>&1; then
  skip "关闭行为断言: 缺 xdotool"
elif ! command -v gcc >/dev/null 2>&1 || ! printf '#include <X11/Xlib.h>\nint main(void){return 0;}\n' | gcc -x c - -o /dev/null -lX11 >/dev/null 2>&1; then
  skip "关闭行为断言: 缺 gcc / libX11 头文件"
else
  cat > "$TMP/wmdelete.c" <<'WMDELETE'
/* 发一条 WM_DELETE_WINDOW 客户端消息(等价于点窗口关闭按钮 / Alt+F4)。
   用法: wmdelete <window-id(十进制或 0x 前缀)> */
#include <X11/Xlib.h>
#include <stdlib.h>
#include <string.h>

int main(int argc, char** argv) {
  if (argc < 2) return 2;
  Display* d = XOpenDisplay(NULL);
  if (d == NULL) return 3;
  Window w = (Window)strtoul(argv[1], NULL, 0);
  XEvent ev;
  memset(&ev, 0, sizeof(ev));
  ev.xclient.type = ClientMessage;
  ev.xclient.window = w;
  ev.xclient.message_type = XInternAtom(d, "WM_PROTOCOLS", False);
  ev.xclient.format = 32;
  ev.xclient.data.l[0] = (long)XInternAtom(d, "WM_DELETE_WINDOW", False);
  ev.xclient.data.l[1] = CurrentTime;
  int ok = XSendEvent(d, w, False, NoEventMask, &ev);
  XFlush(d);
  XCloseDisplay(d);
  return ok ? 0 : 4;
}
WMDELETE
  if ! gcc -O0 -o "$CLOSE_HELPER" "$TMP/wmdelete.c" -lX11 2>"$TMP/wmdelete.log"; then
    skip "关闭行为断言: wmdelete 编译失败($(head -1 "$TMP/wmdelete.log"))"
  else
    cat > "$TMP/close-phase.sh" <<'CLOSEPHASE'
#!/usr/bin/env bash
set -uo pipefail
BIN=$1; DATA=$2; LOG=$3; HELPER=$4; CASE=$5; WATCHER=${6:-}
export NCM_DATA_DIR="$DATA"
# 同首次启动: 不摘掉真实桌面的 WAYLAND_DISPLAY, GTK 会绕过 xvfb 把窗口开到用户屏幕上
unset WAYLAND_DISPLAY
export GDK_BACKEND=x11
# watched: 先起一个假的 StatusNotifierWatcher(见下面的 python 片段), 让托盘宿主真的存在
if [ -n "$WATCHER" ]; then
  python3 "$WATCHER" >"$LOG.watcher" 2>&1 &
  WPID=$!
  sleep 2
  trap 'kill -9 "$WPID" 2>/dev/null || true' EXIT
fi
mkdir -p "$DATA"
if [ "$CASE" = "tray" ] || [ "$CASE" = "watched" ]; then
  printf '{"closeBehavior":"tray"}\n' > "$DATA/settings.json"
fi
"$BIN" >"$LOG" 2>&1 &
P=$!
sleep 7
WID=$(xdotool search --name '轻音 MiniNCM' 2>/dev/null | head -1)
if [ -z "$WID" ]; then
  echo "CLOSE_WINDOW=0"
  kill -9 "$P" 2>/dev/null || true
  exit 0
fi
echo "CLOSE_WINDOW=1"
"$HELPER" "$WID"
echo "SEND_RC=$?"
sleep 3
if kill -0 "$P" 2>/dev/null; then echo "ALIVE_AFTER_CLOSE=1"; else echo "ALIVE_AFTER_CLOSE=0"; fi
MAP=$(xwininfo -id "$WID" 2>/dev/null | sed -n 's/^ *Map State: *//p')
echo "MAP_STATE=${MAP:-gone}"
# 托盘恢复: 用 StatusNotifierItem.SecondaryActivate(托盘条目导出的"中键/次要激活",
# runner 里 set_secondary_activate_target 把它绑成"显示主界面", 见 my_application.cc)。
# 注意 Ayatana 的 item **没有** Activate 方法(实测 introspect 只有 Scroll/SecondaryActivate/
# XAyatanaSecondaryActivate), 所以左键那条路只能在真实宿主的菜单里点, 无头验不了;
# SecondaryActivate 走的是同一个 present_window(), 足以证明"隐藏后能回到主界面"。
if [ "$CASE" = "watched" ]; then
  LINE=$(grep REG_SENDER "$LOG.watcher" 2>/dev/null | head -1)
  SENDER=$(awk '{print $2}' <<<"${LINE:-}")
  IPATH=$(awk '{print $4}' <<<"${LINE:-}")
  if [ -n "${SENDER:-}" ] && [ -n "${IPATH:-}" ] && command -v gdbus >/dev/null 2>&1; then
    gdbus call --session --dest "$SENDER" --object-path "$IPATH" \
      --method org.kde.StatusNotifierItem.SecondaryActivate 0 0 >/dev/null 2>&1
    sleep 3
    RMAP=$(xwininfo -id "$WID" 2>/dev/null | sed -n 's/^ *Map State: *//p')
    echo "MAP_AFTER_RESTORE=${RMAP:-gone}"
  fi
fi
kill -TERM "$P" 2>/dev/null || true
sleep 1
kill -9 "$P" 2>/dev/null || true
CLOSEPHASE
    chmod +x "$TMP/close-phase.sh"

    # ① 默认配置(settings.json 里没有 closeBehavior) ⇒ 点关闭 = 直接退出
    OUTQ=$(timeout -k 10 90 xvfb-run -a dbus-run-session -- \
      "$TMP/close-phase.sh" "$BIN" "$TMP/close-quit/data" "$TMP/close-quit.log" \
      "$CLOSE_HELPER" quit 2>&1)
    printf '%s\n' "$OUTQ" | grep -E '^(CLOSE_WINDOW|SEND_RC|ALIVE_AFTER_CLOSE|MAP_STATE)=' | sed 's/^/  | /'
    if ! grep -q '^CLOSE_WINDOW=1$' <<<"$OUTQ"; then
      bad "关闭行为(默认): 没找到主窗口"
    elif grep -q '^ALIVE_AFTER_CLOSE=0$' <<<"$OUTQ"; then
      ok "关闭行为(默认=直接退出): 收到关闭请求后进程退出"
    else
      bad "关闭行为(默认=直接退出): 收到关闭请求后进程仍存活(应该退出)"
    fi

    # ② settings.json 里 closeBehavior=tray ⇒ 隐藏主窗口; 无托盘宿主时降级为最小化
    OUTT=$(timeout -k 10 90 xvfb-run -a dbus-run-session -- \
      "$TMP/close-phase.sh" "$BIN" "$TMP/close-tray/data" "$TMP/close-tray.log" \
      "$CLOSE_HELPER" tray 2>&1)
    printf '%s\n' "$OUTT" | grep -E '^(CLOSE_WINDOW|SEND_RC|ALIVE_AFTER_CLOSE|MAP_STATE)=' | sed 's/^/  | /'
    if ! grep -q '^CLOSE_WINDOW=1$' <<<"$OUTT"; then
      bad "关闭行为(托盘): 没找到主窗口"
    elif grep -q '^ALIVE_AFTER_CLOSE=1$' <<<"$OUTT"; then
      ok "关闭行为(托盘): 关闭后进程仍在(播放不会被打断)"
    else
      bad "关闭行为(托盘): 关闭后进程退出了(设置没生效)"
    fi
    # xvfb + 独立 dbus session 里没有 StatusNotifierWatcher ⇒ 必须走降级分支
    if grep -qa '无托盘宿主, 降级为最小化到任务栏' "$TMP/close-tray.log" 2>/dev/null; then
      ok "托盘缺席时优雅降级为最小化到任务栏(日志已记录)"
    else
      bad "托盘缺席时没有走降级分支(日志里没有降级记录)"
    fi
    # 设置真的推给了原生(日志能看到当前行为)
    grep -qa '关闭行为 = 隐藏到托盘' "$TMP/close-tray.log" 2>/dev/null \
      && ok "settings.json 的 closeBehavior=tray 已推给 GTK runner" \
      || bad "原生侧没收到 closeBehavior=tray"

    # ③ 托盘宿主**存在**时: 关闭必须真的把窗口隐藏(unmap, 不是退出)
    #
    # 用一个最小的假 StatusNotifierWatcher 占住会话总线上的 well-known name —— 我们只
    # 断言"检测到宿主 ⇒ 建托盘 ⇒ 隐藏窗口", 不验证图标画得好不好看(那是宿主的事, 也是
    # 人工验证项)。需要 python3 + PyGObject, 缺了就 SKIP。
    if ! command -v python3 >/dev/null 2>&1 || ! python3 -c 'import gi; from gi.repository import Gio' >/dev/null 2>&1; then
      skip "托盘宿主存在时的隐藏断言: 缺 python3/PyGObject"
    else
      cat > "$TMP/watcher.py" <<'WATCHER'
# 最小 StatusNotifierWatcher: 只为让会话总线上真的有一个 owner。
# 方法/属性实现足够让客户端不报致命错; 我们不断言图标渲染。
import gi
from gi.repository import Gio, GLib

XML = """
<node>
  <interface name="org.kde.StatusNotifierWatcher">
    <method name="RegisterStatusNotifierItem"><arg type="s" direction="in"/></method>
    <method name="RegisterStatusNotifierHost"><arg type="s" direction="in"/></method>
    <property name="RegisteredStatusNotifierItems" type="as" access="read"/>
    <property name="IsStatusNotifierHostRegistered" type="b" access="read"/>
    <property name="ProtocolVersion" type="i" access="read"/>
    <signal name="StatusNotifierItemRegistered"><arg type="s"/></signal>
    <signal name="StatusNotifierItemUnregistered"><arg type="s"/></signal>
  </interface>
</node>"""

items = []
node = Gio.DBusNodeInfo.new_for_xml(XML)


def on_call(conn, sender, path, iface, method, params, inv):
    if method == "RegisterStatusNotifierItem":
        items.append(params.unpack()[0])
        # 供冒烟脚本回调用: sender = 应用自己的唯一名, val = item 对象路径
        print("REG_SENDER", sender, "REG_PATH", params.unpack()[0], flush=True)
    inv.return_value(None)


def on_get(conn, sender, path, iface, prop):
    if prop == "RegisteredStatusNotifierItems":
        return GLib.Variant("as", items)
    if prop == "IsStatusNotifierHostRegistered":
        return GLib.Variant("b", True)
    if prop == "ProtocolVersion":
        return GLib.Variant("i", 0)
    return None


def on_bus(conn, name):
    conn.register_object(
        "/StatusNotifierWatcher", node.interfaces[0], on_call, on_get, None
    )


def on_acquired(conn, name):
    print("WATCHER_READY", flush=True)


Gio.bus_own_name(
    Gio.BusType.SESSION,
    "org.kde.StatusNotifierWatcher",
    Gio.BusNameOwnerFlags.NONE,
    on_bus,
    on_acquired,
    None,
)
GLib.timeout_add_seconds(120, lambda: False)
GLib.MainLoop().run()
WATCHER
      OUTW=$(timeout -k 10 120 xvfb-run -a dbus-run-session -- \
        "$TMP/close-phase.sh" "$BIN" "$TMP/close-watched/data" \
        "$TMP/close-watched.log" "$CLOSE_HELPER" watched "$TMP/watcher.py" 2>&1)
      printf '%s\n' "$OUTW" | grep -E '^(CLOSE_WINDOW|SEND_RC|ALIVE_AFTER_CLOSE|MAP_STATE|MAP_AFTER_RESTORE)=' | sed 's/^/  | /'
      grep -qa '托盘已就绪' "$TMP/close-watched.log" 2>/dev/null \
        && ok "有 StatusNotifier 宿主时托盘图标已建好" \
        || bad "有宿主却没建出托盘图标"
      if ! grep -q '^CLOSE_WINDOW=1$' <<<"$OUTW"; then
        bad "托盘隐藏: 没找到主窗口"
      elif ! grep -q '^ALIVE_AFTER_CLOSE=1$' <<<"$OUTW"; then
        bad "托盘隐藏: 关闭后进程退出了(应该隐藏继续播放)"
      elif grep -q '^MAP_STATE=IsUnMapped$' <<<"$OUTW"; then
        ok "托盘隐藏: 主窗口已 unmap(隐藏), 进程与播放继续"
      else
        bad "托盘隐藏: 窗口没被隐藏($(grep '^MAP_STATE=' <<<"$OUTW"))"
      fi
      # 恢复: 托盘条目的次要激活(中键口径)必须把主窗口重新 map 回来
      if grep -q '^MAP_AFTER_RESTORE=IsViewable$' <<<"$OUTW"; then
        ok "托盘恢复: 触发托盘条目的 SecondaryActivate 后主窗口重新显示"
      elif ! grep -q '^MAP_AFTER_RESTORE=' <<<"$OUTW"; then
        skip "托盘恢复断言: 托盘条目没注册上来(无 gdbus 或注册延迟)"
      else
        bad "托盘恢复: 触发次要激活后窗口仍是隐藏的($(grep '^MAP_AFTER_RESTORE=' <<<"$OUTW"))"
      fi
    fi
  fi
fi

echo "----- 首次启动日志尾部 -----"
tail -15 "$TMP/first.log" 2>/dev/null | sed 's/^/  | /' || skip "没有首次启动日志"

if [ "$FAILED" -ne 0 ]; then
  echo "桌面无头冒烟: FAIL"
  exit 1
fi
echo "桌面无头冒烟: PASS"
